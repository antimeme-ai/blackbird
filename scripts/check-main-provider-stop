#!/usr/bin/env python3
"""Isolated registered-provider wait/retry/partial cancellation. No network/accounts."""
import argparse
import errno
import fcntl
import importlib.util
import json
import os
from pathlib import Path
import pty
import select
import shlex
import signal
import struct
import subprocess
import sys
import termios
import time
import uuid

ROOT = Path(__file__).resolve().parent.parent

def fake_curl():
    work = Path(os.environ['T1_PROVIDER_WORK'])
    config = sys.stdin.read()
    encoded = next(line.split(' = ', 1)[1] for line in config.splitlines()
                   if line.startswith('data-binary = '))
    request = json.loads(json.loads(encoded))
    def event(kind):
        with (work/'ledger.jsonl').open('a') as out:
            out.write(json.dumps({'event':kind,'pid':os.getpid(),'clock_ns':time.monotonic_ns(),
                                  'request':request})+'\n')
    def stopped(_sig, _frame):
        event('local transport child termination requested')
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, stopped)
    event('request entered fake transport')
    mode = os.environ['T1_PROVIDER_MODE']
    if mode == 'retry':
        sys.stdout.write('\n503');sys.stdout.flush()
        event('fake transient response returned')
        return
    if mode == 'partial':
        partial = b'data: {"type":"response.output_text.delta","item_id":"fixture-partial","delta":"T1_PARTIAL_ORIGINAL"}\n\n'
        (work/'partial-original.bin').write_bytes(partial)
        sys.stdout.buffer.write(partial);sys.stdout.buffer.flush()
        event('partial stream emitted')
    else:
        event('response wait entered')
    # Independently gated fixture. Cancellation, not a timer, ends this child.
    while not (work/'allow-response').exists():
        time.sleep(.02)
    event('response gate released')
    sys.stdout.write('data: '+json.dumps({'type':'response.completed','response':{
        'status':'completed','id':'fixture-response','output':[]}})+'\n\n\n200')
    sys.stdout.flush()

def raw_ui_records(session):
    # Current native capture ABI: little-endian 64-bit host, retained raw ARJ1.
    # Deliberately partial tail is not accepted after this process's clean exit.
    records=[]
    for segment in sorted((session/'raw').glob('*/events.*')):
        data=segment.read_bytes()
        assert data[:8]==b'ARCOJ001'
        offset=112
        while offset<len(data):
            magic,version,kind,sequence,first,length,crc=struct.unpack_from('<4sHHQQII',data,offset)
            assert magic==b'ARJ1' and version==1 and first<=sequence
            end=offset+32+length
            assert end<=len(data)
            if kind==4:
                payload=data[offset+32:end]
                size,site,ordinal=struct.unpack_from('<IIQ',payload,32)
                assert size==len(payload)-32
                records.append((payload[:16],site,ordinal,payload[48:]))
            offset=end
    return records

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('executable',type=Path)
    parser.add_argument('--artifacts',type=Path,required=True)
    parser.add_argument('--mode',choices=('wait','retry','partial','blocked'))
    parser.add_argument('--columns',type=int,default=120)
    parser.add_argument('--rows',type=int,default=40)
    args=parser.parse_args()
    executable=args.executable.resolve()
    root=args.artifacts.resolve()/('provider-stop-'+uuid.uuid4().hex[:10]);root.mkdir(parents=True)
    spec=importlib.util.spec_from_file_location('t1_vt',ROOT/'scripts/terminal-screen-oracle.py')
    vt=importlib.util.module_from_spec(spec);spec.loader.exec_module(vt)
    packet_spec=importlib.util.spec_from_file_location('t1_packet',ROOT/'scripts/native-packet.py')
    packet=importlib.util.module_from_spec(packet_spec);packet_spec.loader.exec_module(packet)
    results=[]
    for mode in ((args.mode,) if args.mode else ('wait','retry','partial','blocked')):
        work=root/mode;work.mkdir()
        curl=work/'curl'
        curl.write_text('#!/bin/sh\nexec '+shlex.quote(sys.executable)+' '+shlex.quote(str(Path(__file__).resolve()))+' --fake-curl "$@"\n');curl.chmod(0o700)
        env=dict(os.environ,BLACKBIRD_AUTH_HOME=str(work/'synthetic-auth'),
                 BLACKBIRD_RESPONSES_CURL=str(curl),T1_PROVIDER_WORK=str(work),T1_PROVIDER_MODE=mode)
        for key in ('BLACKBIRD_EXECUTABLE','ARCO_EXECUTABLE','BLACKBIRD_SPRITE_ASSET'):
            env.pop(key,None)
        def cli(*command,input=None):
            result=subprocess.run([str(executable),*command],env=env,input=input,capture_output=True,text=True,timeout=30)
            assert result.returncode==0,(result.stdout,result.stderr)
            return result
        cli('auth','add-provider','t1-fixture','https://invalid.example/v1','responses-portable','T1_SYNTHETIC_KEY')
        cli('auth','key','t1-fixture','synthetic',input='synthetic-no-account-key\n')
        workflow=work/'workflow.lua'
        workflow.write_text('blackbird.request({retry_policy={max_attempts=3,base_ms=5000,cap_ms=5000}})\n')
        master,slave=pty.openpty()
        output_master,output_slave=pty.openpty()
        fcntl.ioctl(output_slave,termios.TIOCSWINSZ,struct.pack('HHHH',args.rows,args.columns,0,0))
        child=subprocess.Popen([str(executable),'--session',str(work/'session'),'--provider','t1-fixture',
                                '--model','ultramarine-1-flash','--effort','max','--workflow',str(workflow)],
                               env=env,stdin=slave,stdout=output_slave,stderr=output_slave,start_new_session=True)
        screen=vt.Screen();raw=bytearray()
        def pump(seconds=.1):
            until=time.monotonic()+seconds
            while time.monotonic()<until:
                if select.select([output_master],[],[],.02)[0]:
                    try:data=os.read(output_master,65536)
                    except OSError:break
                    if not data:break
                    raw.extend(data);screen.feed(data)
        def send(data):os.write(master,data);pump()
        def wait(predicate,description):
            until=time.monotonic()+12
            while time.monotonic()<until:
                pump(.03)
                if predicate():return
            raise AssertionError((description,screen.text()))
        def ledger():
            return [json.loads(line) for line in (work/'ledger.jsonl').read_text().splitlines()] if (work/'ledger.jsonl').exists() else []
        def interrupted(signum,_frame):raise KeyboardInterrupt(f'fixture signal {signum}')
        signal.signal(signal.SIGTERM,interrupted)
        signal.signal(signal.SIGINT,interrupted)
        try:
            wait(lambda:'Workflow reloads' in screen.text(),'startup')
            send(b'T1_OBJECTIVE\r')
            target='partial stream emitted' if mode=='partial' else 'response wait entered'
            if mode=='retry':wait(lambda:'retry 2/' in screen.text(),'retry wait before dispatch')
            else:wait(lambda:any(x['event']==target for x in ledger()),target)
            send(b'/lua print("HELD_".."NEXT")\r');send(b'PRESERVED_PROVIDER_DRAFT')
            if mode == 'blocked':
                filled=0
                def fill():
                    nonlocal filled
                    for extent in (4096,256,16,1):
                        while True:
                            try:filled+=os.write(output_slave,b'X'*extent)
                            except BlockingIOError:break
                fill()
                assert filled>0
                endpoint={'fill_clock_ns':time.monotonic_ns(),'drained_bytes_before_stop':len(raw)}
                os.write(master,b'\x1b')
                endpoint['decoded_input_written_clock_ns']=time.monotonic_ns()
                until=time.monotonic()+12
                while time.monotonic()<until:
                    fill() # retain actual backpressure, no output master reads
                    state=packet.read_packet(work/'session/ui-state.bbm')
                    if any(x['state']=='interrupted locally' for x in state['intentions']):break
                    time.sleep(.02)
                else:raise AssertionError('native interruption absent before output drain')
                endpoint['native_result_observed_clock_ns']=time.monotonic_ns()
                assert len(raw)==endpoint['drained_bytes_before_stop']
                assert bytes.fromhex(state['draft'])==b'PRESERVED_PROVIDER_DRAFT'
                assert any(x['state']=='held' for x in state['intentions'])
                (work/'before-drain-native.json').write_text(json.dumps(state,indent=2))
                (work/'before-drain-native.bbm').write_bytes((work/'session/ui-state.bbm').read_bytes())
                fcntl.ioctl(output_slave,termios.TIOCSWINSZ,struct.pack('HHHH',16,42,0,0))
                os.kill(child.pid,signal.SIGWINCH)
                wait(lambda:'Turn interrupted locally' in screen.text() and
                     not screen.synchronized_update,'coherent eventual local result after drain')
                endpoint['eventual_frame_observed_clock_ns']=time.monotonic_ns()
                endpoint['filler_bytes']=filled
                (work/'blocked-endpoints.json').write_text(json.dumps(endpoint,indent=2))
            else:
                send(b'\x1b')
                wait(lambda:'Turn interrupted locally' in screen.text(),'observed local interruption')
            native=packet.read_packet(work/'session/ui-state.bbm')
            intentions=native['intentions']
            objective=next(x for x in intentions if x['revisions']==['T1_OBJECTIVE'])
            pending=next(x for x in intentions if x['revisions']==['/lua print("HELD_".."NEXT")'])
            entered=[x for x in ledger() if x['event']=='request entered fake transport']
            assert len(entered)==1,(mode,entered)
            assert any(x.get('content')=='T1_OBJECTIVE' for x in entered[0]['request']['input'])
            assert objective['context_entry'] and len(objective['requests'])==1 and objective['requests'][0]['included'] is True
            assert pending['state']=='held' and bytes.fromhex(native['draft'])==b'PRESERVED_PROVIDER_DRAFT'
            if mode=='partial':
                original=(work/'partial-original.bin').read_bytes()
                assert any(original in file.read_bytes() for file in (work/'session').rglob('*') if file.is_file()),'partial original not retained'
            (work/'screen.txt').write_text(screen.text())
            (work/'native-observation.json').write_text(json.dumps(native,indent=2))
            results.append({'mode':mode,'observed':'local interrupted','transport_requests':len(entered),'remote_disposition':'unknown'})
        finally:
            signal.signal(signal.SIGTERM,signal.SIG_IGN)
            signal.signal(signal.SIGINT,signal.SIG_IGN)
            # Explicit disposable-fixture stop/exit, never a silence-driven kill.
            send(b'\x03');send(b'\x15/exit\r');pump(.3)
            rc=child.wait(timeout=15)
            (work/'terminal.bin').write_bytes(raw)
            (work/'process.json').write_text(json.dumps({'pid':child.pid,'returncode':rc}))
            assert rc==0
            if mode=='blocked':
                records=raw_ui_records(work/'session')
                saved=(work/'before-drain-native.bbm').read_bytes()
                native=[(lane,ordinal) for lane,site,ordinal,body in records
                        if site==4021 and body[32:]==saved]
                blocked=[(lane,ordinal) for lane,site,ordinal,body in records
                         if site==4045 and len(body)>=37 and
                         struct.unpack_from('<q?i',body,24) in
                         ((-1,True,errno.EAGAIN),(-1,True,errno.EWOULDBLOCK))]
                assert any(lane==owner and event<result for lane,event in blocked
                           for owner,result in native),'no native EAGAIN before native result save'
                (work/'native-eagain.json').write_text(json.dumps(
                    {'blocked':[(lane.hex(),ordinal) for lane,ordinal in blocked],
                     'result_save':[(lane.hex(),ordinal) for lane,ordinal in native]},indent=2))
            os.close(master);os.close(slave);os.close(output_master);os.close(output_slave)
    (root/'results.json').write_text(json.dumps(results,indent=2))
    print(root);print(json.dumps(results,indent=2))

if __name__=='__main__':
    if len(sys.argv)>1 and sys.argv[1]=='--fake-curl':fake_curl()
    else:main()
